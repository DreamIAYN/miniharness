# ===== mini-harness configuration =====
# Copy to .env and edit. Values in .env do not override existing shell env vars.

# --- server ---
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8000
HARNESS_LOG_LEVEL=INFO
# Comma-separated origins. Use a concrete origin in production.
HARNESS_CORS_ORIGINS=*

# REQUIRED in production. If empty, a random token is generated and logged.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
HARNESS_ADMIN_TOKEN=

# --- storage ---
HARNESS_DB_PATH=data/harness.db
HARNESS_WORKSPACE_ROOT=data/workspaces
HARNESS_KEEP_WORKSPACES=false

# --- LLM: any OpenAI-compatible chat-completions endpoint ---
# DeepSeek:  https://api.deepseek.com/v1   model: deepseek-flash (vision-capable)
# OpenAI:    https://api.openai.com/v1     model: gpt-4o-mini
# vLLM:      http://127.0.0.1:8001/v1      model: your-served-model
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Request-facing default alias. Empty means LLM_MODEL.
LLM_DEFAULT_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=0
LLM_MAX_RETRIES=2
LLM_THINKING=true
LLM_REASONING_EFFORT=high

# --- OpenCode Zen (OpenAI-compatible chat models) ---
# Get a key at https://opencode.ai/console. Enables the model IDs listed below.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_ZEN_MODELS=deepseek-v4.1-flash,deepseek-v4-pro,glm-5.3-flash,glm-5.3,minimax-m3

# --- agent ---
AGENT_DEFAULT_MAX_STEPS=8
AGENT_MAX_STEPS_LIMIT=20
# 0 = no wall-clock limit for a run.
AGENT_RUN_TIMEOUT_SECONDS=0
# DeepSeek max output is 384K (393216). Lower this for providers with smaller limits.
AGENT_MAX_OUTPUT_TOKENS=393216
AGENT_TEMPERATURE=0.2
# Maximum nesting depth for spawn_subagent (0 disables subagents).
AGENT_MAX_SUBAGENT_DEPTH=2

# Automatic context compression. Set the window to 0 to disable.
AGENT_CONTEXT_WINDOW_TOKENS=1000000
AGENT_CONTEXT_COMPRESS_RATIO=0.8
AGENT_CONTEXT_COMPRESS_INPUT_TOKENS=32000
AGENT_CONTEXT_SUMMARY_MAX_TOKENS=1024

# --- call logs (prompt/response bodies) ---
# Stored separately from the usage ledger; deleting logs does not change quota accounting.
CALL_LOG_ENABLED=true
CALL_LOG_RETENTION_DAYS=7
# 0 = store full bodies. Set a positive char cap to limit each field.
CALL_LOG_MAX_CHARS=0

# --- sandbox ---
# local = resource isolation only (NOT a security boundary)
# docker = container isolation (recommended for untrusted code)
HARNESS_SANDBOX_BACKEND=local
SANDBOX_DOCKER_IMAGE=python:3.12-slim
SANDBOX_DOCKER_PULL=true
SANDBOX_ALLOW_NETWORK=false
SANDBOX_DEFAULT_TIMEOUT_SECONDS=15
SANDBOX_MAX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_MB=256
SANDBOX_CPU_SECONDS=10
SANDBOX_MAX_OUTPUT_BYTES=65536

# --- quotas ---
DEFAULT_QUOTA_TOKENS=100000

# --- tools ---
TOOL_OUTPUT_CHARS=8000
FILE_READ_MAX_BYTES=131072
FILE_WRITE_MAX_BYTES=262144
FILE_LIST_MAX_ENTRIES=200
